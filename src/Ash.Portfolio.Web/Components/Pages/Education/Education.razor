@page "/education"
@using Ash.Portfolio.Web.Components.Models;

@inject IEducationRepository EducationRepository

@code {
    private List<Infrastructure.Data.Education.Institute> InstituteData { get; set; } = [];

    private List<ContentRow> ContentRows { get; init; } = new();

    protected override async Task OnInitializedAsync()
    {
        var instituteData = await EducationRepository.GetInstitutesWithDescriptionAsync();

        InstituteData = instituteData.ToList();

        foreach (var institute in InstituteData)
        {
            ContentRows.Add(new ContentRow
            {
                LocalisedPrimaryTitle = institute.Name,
                LocalisedSecondaryTitle = institute.Title,
                HtmlDescriptionList = institute.DescriptionRows.Select(d => LocalisationService.GetString(d.Text).ToString()).ToList(),
                LogoPath = institute.ImageLink,
                LogoUrl = institute.Link
            });
        }
    }
}

<PageTitle>@LocalisationService.GetString("Ashley Gibson") - @LocalisationService.GetString("Education")</PageTitle>

<div class="container p-3 pt-0">
    <Ash.Portfolio.Web.Components.Shared.PageTitle LocalisedString="Here's what I've learnt..." />

    <Ash.Portfolio.Web.Components.Shared.ContentGrid ContentRows="@ContentRows" />
</div>

<Ash.Portfolio.Web.Components.Shared.NavBar />

<Ash.Portfolio.Web.Components.Shared.CVButton />