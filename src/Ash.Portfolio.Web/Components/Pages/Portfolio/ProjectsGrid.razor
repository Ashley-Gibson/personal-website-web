@inherits ComponentBase

@inject IPortfolioRepository PortfolioRepository
@inject IPortfolioService PortfolioService

@code{
    private List<Infrastructure.Data.Portfolio.Project> CompleteProjectData { get; set; } = [];

    private List<Infrastructure.Data.Portfolio.Project> InProgressProjectData { get; set; } = [];

    private List<Infrastructure.Data.Portfolio.Project> GamesProjectData { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var projects = await PortfolioRepository.GetProjectsAsync();

        CompleteProjectData = PortfolioService.FilterProjectsByType(projects, ProjectType.Complete).ToList();
        InProgressProjectData = PortfolioService.FilterProjectsByType(projects, ProjectType.InProgress).ToList();
        GamesProjectData = PortfolioService.FilterProjectsByType(projects, ProjectType.Game).ToList();
    }
}

<!-- COMPLETE -->
<div class="row completePortfolio m-4 mt-0 text-center">
    @foreach (var project in CompleteProjectData)
    {
        <div class="col-4 p-0 pt-3">
            <a href="@project.RepositoryLink" target="_blank">
                <p>@project.Name - @project.Technologies</p>
                <img src="@project.ImageLink">
            </a>
        </div>
    }
</div>

<!-- IN PROGRESS -->
<div class="row inProgressPortfolio m-4 mt-0 mb-5 pb-5 text-center" style="display:none;">
    @foreach (var project in InProgressProjectData)
    {
        <div class="col-4 p-0 pt-3">
            <a href="@project.RepositoryLink" target="_blank">
                <p>@project.Name - @project.Technologies</p>
                <img src="@project.ImageLink">
            </a>
        </div>
    }
</div>

<!-- GAMES -->
<div class="row gamesPortfolio m-4 mt-0 mb-5 pb-5 text-center" style="display:none;">
    @foreach (var project in GamesProjectData)
    {
        <div class="col-4 p-0 pt-3">
            <a href="@project.RepositoryLink" target="_blank">
                <p>@project.Name - @project.Technologies</p>
                <img src="@project.ImageLink">
            </a>
        </div>
    }
</div>