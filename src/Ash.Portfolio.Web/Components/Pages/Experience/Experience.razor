@page "/experience"
@using Ash.Portfolio.Web.Components.Models

@inject IExperienceRepository ExperienceRepository

@code {
    private List<Infrastructure.Data.Experience.Role> RoleData { get; set; } = [];

    private List<ContentRow> ContentRows { get; init; } = new();

    protected override async Task OnInitializedAsync()
    {
        var roleData = await ExperienceRepository.GetRolesWithDescriptionsAsync();

        RoleData = roleData.ToList();

        foreach (var role in RoleData)
        {
            ContentRows.Add(new ContentRow
            {
                LocalisedPrimaryTitle = role.EmployerName,
                LocalisedSecondaryTitle = role.Title,
                HtmlDescriptionList = role.DescriptionRows.Select(d => LocalisationService.GetString(d.Text).ToString()).ToList(),
                LogoPath = role.ImageLink,
                LogoUrl = role.EmployerLink
            });
        }
    }
}

<PageTitle>@LocalisationService.GetString("Ashley Gibson") - @LocalisationService.GetString("Experience")</PageTitle>

<div class="container p-3 pt-0">
    <Ash.Portfolio.Web.Components.Shared.PageTitle LocalisedString="My career so far..." />

    <Ash.Portfolio.Web.Components.Shared.ContentGrid ContentRows="@ContentRows" />
</div>

<Ash.Portfolio.Web.Components.Shared.NavBar />

<Ash.Portfolio.Web.Components.Shared.CVButton />